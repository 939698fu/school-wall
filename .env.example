# 复制为 .env 后修改（.env 已在 .gitignore 中，不会提交到 Git）
# cp .env.example .env

# 对外暴露的后端端口
APP_PORT=8080

# MySQL（docker-compose 内 mysql 服务使用）
MYSQL_ROOT_PASSWORD=请改成强密码_root
MYSQL_DATABASE=school_wall
MYSQL_USER=schoolwall
MYSQL_PASSWORD=请改成强密码_app

# JWT（生产环境务必改为长随机串，至少 32 字符）
JWT_SECRET=请改成至少32位的随机字符串

# 微信小程序（须与前端 manifest.json 中 mp-weixin.appid 一致）
# 注意：等号后面不要写注释，每行一个变量，例如：
# WECHAT_APP_ID=wxec7999d3f2fb4a98
# WECHAT_APP_SECRET=你的AppSecret
WECHAT_APP_ID=wxec7999d3f2fb4a98
WECHAT_APP_SECRET=你的AppSecret
# 以下两行可选，与上面等价
# WECHAT_MINIAPP_APP_ID=wxec7999d3f2fb4a98
# WECHAT_MINIAPP_APP_SECRET=你的AppSecret
